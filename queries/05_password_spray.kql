// Password spray: one source failing against many users with few attempts each, plus any success
// ATT&CK: T1110.003 Password Spraying
// Data: Microsoft Sentinel (SigninLogs)
// Why: per-user lockout misses spray by design. Group by source and time window instead.
let lookback = 1d;
let windowSize = 1h;
let minUsers = 10;
let failures = dynamic(["50126", "50053", "50055", "50056"]);   // bad password, locked, expired, missing
let spray =
    SigninLogs
    | where TimeGenerated > ago(lookback)
    | where ResultType in (failures)
    | summarize Users = dcount(UserPrincipalName), Attempts = count(), SampleUsers = make_set(UserPrincipalName, 15),
                Apps = make_set(AppDisplayName, 5), UserAgents = make_set(UserAgent, 5)
        by IPAddress, Window = bin(TimeGenerated, windowSize)
    | where Users >= minUsers and Attempts < Users * 3;
let successes =
    SigninLogs
    | where TimeGenerated > ago(lookback)
    | where ResultType == "0"
    | summarize SucceededUsers = make_set(UserPrincipalName, 15) by IPAddress;
spray
| join kind=leftouter successes on IPAddress
| extend AnySuccess = array_length(SucceededUsers) > 0
| project-away IPAddress1
| order by AnySuccess desc, Users desc
